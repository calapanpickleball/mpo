rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/mpo-users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/mpo-users/$(request.auth.uid)).data.role : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function isStaff() { return role() in ['admin', 'viewer']; }

    // Registrations: public form can create; staff read; only admin edits/deletes
    match /mpo-cup2026/{id} {
      allow create: if true;            // TODO tighten (required fields, status == 'Submitted')
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /mpo-cup2026-shirts/{id}  { allow read: if isStaff(); allow write: if isAdmin(); }
    match /mpo-cup2026-finance/{id} { allow read, write: if isAdmin(); }
    match /mpo-users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Event settings document (SET in firebase-init.js): public read, admin write.
    // !! Adjust the path to match SET in your firebase-init.js !!
    match /settings/{doc} { allow read: if true; allow write: if isAdmin(); }
  }
}
